# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Project: Cost-Sensitive Fraud Detection with Operator Feedback Loop
#
# INSTRUCTIONS:
# 1. Copy this file to .env: `cp .env.example .env` (or `Copy-Item .env.example .env`)
# 2. Update placeholder values for your local environment.
# 3. DO NOT commit actual secrets, passwords, or production API keys to git.
# ==============================================================================

# Application & API Runtime
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=fraud_db
DATABASE_URL=postgresql+psycopg://fraud_user:change_me_in_local_env@localhost:5433/fraud_db

# Dedicated Test Database Configuration (Isolated from working application database)
TEST_POSTGRES_DB=fraud_test_db
TEST_DATABASE_URL=postgresql+psycopg://fraud_user:change_me_in_local_env@localhost:5433/fraud_test_db

# Security & Authentication (JWT)
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_generate_a_secure_random_key_before_running
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Paths & Active Version
MODEL_DIR=./ml/models
ACTIVE_MODEL_VERSION=xgb-cost-v1

# ==============================================================================
# COST-SENSITIVE DECISION ENGINE ASSUMPTIONS
#
# IMPORTANT RESEARCH NOTICE:
# These values represent provisional research assumptions for simulation, policy
# optimization, and algorithmic evaluation. They do NOT reflect verified monetary
# losses of any commercial institution. All reporting must treat these values
# as configurable parameters evaluated through sensitivity analysis.
# ==============================================================================
COST_FALSE_NEGATIVE=100.00    # Cost of missing a fraudulent transaction (stolen funds, chargeback)
COST_FALSE_POSITIVE=5.00      # Cost of flagging a genuine user (friction, investigation, churn)
COST_OPERATOR_REVIEW=5.00     # Operational salary/time cost per transaction reviewed by human
COST_BLOCK_FRICTION=50.00     # Customer churn and friction cost of an outright false block
MAX_REVIEW_CAPACITY_PCT=5.0   # Maximum percentage of total transaction volume allowed into review queue

# AI Chatbot Assistant (Optional Read-Only Auxiliary Service)
# Placeholders for future assistant integration. Provider agnostic; leave empty if disabled.
CHATBOT_ENABLED=false
CHATBOT_PROVIDER=placeholder_provider
CHATBOT_API_KEY=placeholder_api_key_leave_empty_until_approved
CHATBOT_MODEL_NAME=placeholder_model_name
